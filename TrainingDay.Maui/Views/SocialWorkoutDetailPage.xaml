<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrainingDay.Maui.ViewModels.Pages"
             xmlns:vm="clr-namespace:TrainingDay.Maui.ViewModels"
             xmlns:resx="clr-namespace:TrainingDay.Maui.Resources.Strings"
             xmlns:controls="clr-namespace:TrainingDay.Maui.Controls"
             xmlns:data="clr-namespace:TrainingDay.Common.Models;assembly=TrainingDay.Common"
             x:Class="TrainingDay.Maui.Views.SocialWorkoutDetailPage"
             x:DataType="viewModels:SocialWorkoutDetailViewModel"
             Title="{Binding Workout.Name}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Dark={StaticResource ContentPageBackgroundColor}, Light={StaticResource ContentPageBackgroundColorLight}}">

    <Shell.TitleView>
        <Grid Style="{StaticResource PageTitleViewStyle}">
            <Label Style="{StaticResource PageTitleStyle}" Text="{Binding Workout.Name}"/>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="*,Auto">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Exercises}" SelectionMode="None" Margin="10,0">
            <!-- Summary card scrolls with the list so exercises get the full height -->
            <CollectionView.Header>
                <Border Style="{StaticResource BorderCellStyle}" Padding="14,12" Margin="0,10,0,10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Workout.Name}" FontSize="20" FontAttributes="Bold"/>

                        <Label Grid.Row="1" Grid.Column="0" FontSize="13" LineBreakMode="TailTruncation">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Workout.OwnerNickname}" FontAttributes="Bold"
                                          TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"/>
                                    <Span Text="  ·  " TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                                    <Span Text="{Binding Workout.DateFormatted}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Workout.TopMuscles}" IsVisible="{Binding Workout.HasTopMuscles}"
                               FontSize="13" TextColor="{StaticResource Main}"/>

                        <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Spacing="6">
                            <Label Text="⏱" FontSize="13" VerticalOptions="Center"/>
                            <Label Text="{Binding Workout.DurationFormatted}" FontSize="13" VerticalOptions="Center"/>
                            <Label Text="·" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                            <Label Text="{Binding Workout.ExerciseCountText}" FontSize="13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- Like pill: real hit target instead of a bare heart glyph -->
                        <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" VerticalOptions="Start" Padding="14,8" MinimumHeightRequest="44"
                                StrokeShape="RoundRectangle 22" StrokeThickness="1" BackgroundColor="Transparent"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                SemanticProperties.Description="{x:Static resx:AppResources.LikesString}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LikeCommand}" NumberOfTapsRequired="1" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Workout.IsLikedByMe}" Value="True">
                                    <Setter Property="Stroke" Value="#E53935"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="♡" FontSize="20" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Workout.IsLikedByMe}" Value="True">
                                            <Setter Property="Text" Value="♥"/>
                                            <Setter Property="TextColor" Value="#E53935"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Workout.LikesCount}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>
            </CollectionView.Header>
            <CollectionView.Footer>
                <ContentView HeightRequest="10"/>
            </CollectionView.Footer>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="8" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrainingExerciseViewModel">
                    <Border Style="{StaticResource BorderCellStyle}">
                        <Grid Margin="0" Padding="0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border StrokeShape="RoundRectangle 10" Stroke="Transparent" Grid.Column="0" Margin="0" Padding="5"
                                    BackgroundColor="White" HorizontalOptions="Center" VerticalOptions="Center">
                                <controls:ImageCache HeightRequest="60" WidthRequest="60" CodeNum="{Binding CodeNum}" ExerciseId="{Binding ExerciseId}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" MaxLines="2" LineBreakMode="TailTruncation"/>

                                <FlexLayout BindableLayout.ItemsSource="{Binding Muscles}" Style="{StaticResource MuscleFlexStyle}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MuscleViewModel">
                                            <!--AbsoluteLayout needed for proper draw muscle label. without it cropped in the end-->
                                            <AbsoluteLayout>
                                                <Border Style="{StaticResource MuscleBorderCellStyle}">
                                                    <Label Text="{Binding Name}" FontSize="11" TextColor="White" LineBreakMode="NoWrap"/>
                                                </Border>
                                            </AbsoluteLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <!-- Sets: reps only or reps + weight -->
                                <FlexLayout AlignContent="Start" AlignItems="Center" BindableLayout.ItemsSource="{Binding WeightAndRepsItems}" Direction="Row"
                                    IsVisible="{Binding IsTrackedBySets}" JustifyContent="Start" Wrap="Wrap">
                                    <FlexLayout.Triggers>
                                        <DataTrigger Binding="{Binding HasWeight}" TargetType="FlexLayout" Value="False">
                                            <Setter Property="BindableLayout.ItemTemplate" Value="{StaticResource RepsChipTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasWeight}" TargetType="FlexLayout" Value="True">
                                            <Setter Property="BindableLayout.ItemTemplate" Value="{StaticResource RepsAndWeightChipTemplate}" />
                                        </DataTrigger>
                                    </FlexLayout.Triggers>
                                </FlexLayout>

                                <Label Margin="0" Padding="0" FontSize="14"
                                    IsVisible="{Binding Tags, Converter={StaticResource ExerciseTagExistsConverter}, ConverterParameter={x:Static data:ExerciseTags.ExerciseByTime}}"
                                    Text="{Binding Time, StringFormat={x:Static resx:AppResources.CurrentTimeString}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Sticky primary action, styled like the other pages' main buttons -->
        <Button Grid.Row="1" Text="{x:Static resx:AppResources.AddToMyWorkoutsString}" Command="{Binding AddToMyWorkoutsCommand}"
                Style="{StaticResource ActionButton}" CornerRadius="20" Margin="10,5,10,10" HeightRequest="50" FontSize="Body"/>
    </Grid>
</ContentPage>

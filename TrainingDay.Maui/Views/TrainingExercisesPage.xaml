<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrainingDay.Maui.ViewModels.Pages"
             xmlns:models="clr-namespace:TrainingDay.Maui.ViewModels"
             xmlns:controls="clr-namespace:TrainingDay.Maui.Controls"
             xmlns:resx="clr-namespace:TrainingDay.Maui.Resources.Strings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TrainingDay.Maui.Views.TrainingExercisesPage">

    <Shell.TitleView>
        <Grid Style="{StaticResource PageTitleViewStyle}" ColumnDefinitions="*,auto, auto">
            <Label Style="{StaticResource PageTitleStyle}" Grid.Column="0" Text="{x:Static resx:AppResources.TrainingString}"/>

            <ImageButton Style="{StaticResource HeaderIconButtonStyle}" Grid.Column="1" Source="add_empty.png" Command="{Binding AddExercisesCommand}"
                         SemanticProperties.Description="{x:Static resx:AppResources.AddExercisesString}"
                         ToolTipProperties.Text="{x:Static resx:AppResources.AddExercisesString}">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=Black, Dark=White}" />
                </ImageButton.Behaviors>
            </ImageButton>

            <ImageButton Style="{StaticResource HeaderIconButtonStyle}" Grid.Column="2" Source="settings.png" Command="{Binding ShowTrainingSettingsPageCommand}"
                         SemanticProperties.Description="{x:Static resx:AppResources.SettingsString}"
                         ToolTipProperties.Text="{x:Static resx:AppResources.SettingsString}">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=Black, Dark=White}" />
                </ImageButton.Behaviors>
            </ImageButton>
        </Grid>
    </Shell.TitleView>

    <controls:TooltipControlContainer x:Name="Container" RowSpacing="5" BackgroundColor="Transparent" RowDefinitions="auto,*,auto">
        <Border Style="{StaticResource MaterialBorder}">
            <Grid>
                <Label Text="{x:Static resx:AppResources.NameString}" Style="{StaticResource MaterialLabel}"/>
                <Entry Text="{Binding Training.Title}" HorizontalOptions="Fill" FontSize="22" VerticalOptions="End"/>
            </Grid>
        </Border>

        <CollectionView ItemsSource="{Binding Training.Exercises}" Grid.Row="1" x:Name="ItemsListView" SelectionMode="Single"
                    ItemsUpdatingScrollMode="KeepScrollOffset" VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TrainingExerciseViewModel">
                    <Border Grid.Row="0" MinimumHeightRequest="80" x:Name="viewCell" Style="{StaticResource BorderCellStyle}" Margin="0,-1,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ItemTappedCommand, Source={RelativeSource AncestorType={x:Type viewModels:TrainingExercisesPageViewModel}}, x:DataType=viewModels:TrainingExercisesPageViewModel}"
                                              CommandParameter="{Binding}"/>
                            <DropGestureRecognizer
                                    AllowDrop="True"
                                    DragLeaveCommand="{Binding ItemDragLeave, Source={RelativeSource AncestorType={x:Type viewModels:TrainingExercisesPageViewModel}}, x:DataType=viewModels:TrainingExercisesPageViewModel}"
                                    DragLeaveCommandParameter="{Binding}"
                                    DragOverCommand="{Binding ItemDraggedOver, Source={RelativeSource AncestorType={x:Type viewModels:TrainingExercisesPageViewModel}}, x:DataType=viewModels:TrainingExercisesPageViewModel}"
                                    DragOverCommandParameter="{Binding}"
                                    DropCommand="{Binding ItemDropped, Source={RelativeSource AncestorType={x:Type viewModels:TrainingExercisesPageViewModel}}, x:DataType=viewModels:TrainingExercisesPageViewModel}"
                                    DropCommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                        <Grid Padding="0" Margin="5" ColumnSpacing="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" HeightRequest="70" WidthRequest="70" VerticalOptions="Center" BackgroundColor="White" Stroke="Transparent">
                                <Grid HeightRequest="70" WidthRequest="70">
                                    <controls:ImageCache HeightRequest="70" WidthRequest="70" CodeNum="{Binding CodeNum}" ExerciseId="{Binding ExerciseId,Mode=TwoWay}">
                                        <controls:ImageCache.GestureRecognizers>
                                            <DragGestureRecognizer
                                                CanDrag="True"
                                                DragStartingCommand="{Binding ItemDragged, Source={RelativeSource AncestorType={x:Type viewModels:TrainingExercisesPageViewModel}}, x:DataType=viewModels:TrainingExercisesPageViewModel}"
                                                DragStartingCommandParameter="{Binding}" />
                                        </controls:ImageCache.GestureRecognizers>
                                    </controls:ImageCache>

                                    <Grid VerticalOptions="End" HeightRequest="15">
                                        <Grid.IsVisible>
                                            <Binding Path="SuperSetId" Converter="{StaticResource IsNotEqualConverter}">
                                                <Binding.ConverterParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Binding.ConverterParameter>
                                            </Binding>
                                        </Grid.IsVisible>
                                        <RoundRectangle Stroke="RoyalBlue" CornerRadius="0,0,5,5" Fill="RoyalBlue" />
                                        <Label HorizontalOptions="Center" FontSize="11" VerticalOptions="End" >
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static resx:AppResources.SuperSetString}" TextColor="White"/>
                                                    <Span Text=" "/>
                                                    <Span Text="{Binding SuperSetNum}" TextColor="White"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                </Grid>
                            </Border>

                            <CheckBox Grid.Column="2" VerticalOptions="Center" IsChecked="{Binding IsSelected}" HorizontalOptions="End"
                                  IsVisible="{Binding IsCheckBoxVisible}" />

                            <VerticalStackLayout Grid.Column="1" Padding="0" Margin="0" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="17" HorizontalTextAlignment="Center" HorizontalOptions="Fill" VerticalOptions="Start" Margin="0"/>
                                <FlexLayout BindableLayout.ItemsSource="{Binding Muscles}" Style="{StaticResource MuscleFlexStyle}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:MuscleViewModel">
                                            <AbsoluteLayout>
                                                <Border Style="{StaticResource MuscleBorderCellStyle}">
                                                    <Label Text="{Binding Name}" FontSize="11" TextColor="White" LineBreakMode="NoWrap"/>
                                                </Border>
                                            </AbsoluteLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>

                            <ImageButton Grid.Column="2" WidthRequest="30" HeightRequest="30" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" Source="close.png" 
                                             Command="{Binding DeleteExerciseCommand, Source={RelativeSource AncestorType={x:Type viewModels:TrainingExercisesPageViewModel}}, x:DataType=viewModels:TrainingExercisesPageViewModel}" CommandParameter="{Binding }" BackgroundColor="Transparent" 
                                             IsVisible="{Binding IsCheckBoxVisible,Converter={StaticResource InvertedBoolConverter}}">
                                <ImageButton.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=Black, Dark=White}" />
                                </ImageButton.Behaviors>
                            </ImageButton>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" x:Name="ControlGrid">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="StateA">
                        <VisualState.Setters>
                            <Setter TargetName="MakeTrainingButton" Property="IsVisible" Value="True"/>
                            <Setter TargetName="ExerciseActionGrid" Property="IsVisible" Value="False"/>
                        </VisualState.Setters>
                        <VisualState.StateTriggers>
                            <StateTrigger IsActive="{Binding IsExercisesCheckBoxVisible, Converter={StaticResource InvertedBoolConverter}}"/>
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState Name="StateB">
                        <VisualState.Setters>
                            <Setter TargetName="MakeTrainingButton" Property="IsVisible" Value="False"/>
                            <Setter TargetName="ExerciseActionGrid" Property="IsVisible" Value="True"/>
                        </VisualState.Setters>
                        <VisualState.StateTriggers>
                            <StateTrigger IsActive="{Binding IsExercisesCheckBoxVisible}"/>
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Button x:Name="MakeTrainingButton" Margin="0,5,0,0" CornerRadius="20" Text="{x:Static resx:AppResources.MakeTrainingString}" Command="{Binding MakeTrainingCommand}" 
                    TextColor="White" FontSize="Body" />

            <Grid x:Name="ExerciseActionGrid" HorizontalOptions="Fill" ColumnSpacing="5" Margin="5,0" ColumnDefinitions="*,*">
                <Button Grid.Column="0" CornerRadius="20" Text="{x:Static resx:AppResources.CancelString}" Command="{Binding CancelActionCommand}" HorizontalOptions="Fill"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" BorderWidth="1"/>
                <Button Grid.Column="1" CornerRadius="20" Text="{Binding ExerciseActionString}" Command="{Binding StartActionCommand}" HorizontalOptions="Fill" Style="{StaticResource ActionButton}"/>
            </Grid>
        </Grid>
        
        <controls:ToolTipControl Grid.Row="1" 
                              Text="{x:Static resx:AppResources.ToolTipHoldImageExercises}" Title="{x:Static resx:AppResources.SettingsString}" 
                              NeverShow="{Binding Source={x:Static Application.Current},Path=ToolTipManager.ToolTipHoldImageExercises,Mode=TwoWay}" 
                              AttachedControl="ItemsListView" SkipText="{x:Static resx:AppResources.SkipString}" NeverShowText="{x:Static resx:AppResources.GotItString}" Position="Center"/>

        <controls:ToolTipControl Grid.Row="1" 
                              Text="{x:Static resx:AppResources.ToolTipStartWorkout}" Title="{x:Static resx:AppResources.Execution}" 
                              NeverShow="{Binding Source={x:Static Application.Current},Path=ToolTipManager.ToolTipStartWorkout,Mode=TwoWay}" 
                              AttachedControl="ControlGrid" SkipText="{x:Static resx:AppResources.SkipString}" NeverShowText="{x:Static resx:AppResources.GotItString}" Position="Center"/>

    </controls:TooltipControlContainer>
</ContentPage>
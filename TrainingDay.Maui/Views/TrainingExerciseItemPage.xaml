<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TrainingDay.Maui.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.TabBarIsVisible="False"
             HideSoftInputOnTapped="True"
             x:Class="TrainingDay.Maui.Views.TrainingExerciseItemPage">
    <Shell.TitleView>
        <Grid Style="{StaticResource PageTitleViewStyle}" ColumnDefinitions="*,auto">
            <Label Style="{StaticResource PageTitleStyle}" x:Name="TitleLabel" Grid.Column="0"/>

            <ImageButton Style="{StaticResource HeaderIconButtonStyle}" Grid.Column="1" Source="save.png" Clicked="Save_clicked"
                         SemanticProperties.Description="{x:Static resx:AppResources.SaveString}"
                         ToolTipProperties.Text="{x:Static resx:AppResources.SaveString}">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=Black, Dark=White}" />
                </ImageButton.Behaviors>
            </ImageButton>
        </Grid>
    </Shell.TitleView>

    <ScrollView Orientation="Vertical">
        <Grid>
            <controls:ExerciseView x:Name="ExerciseView" ImageTappedEvent="ExerciseView_OnImageTappedEvent" />

            <Border HeightRequest="250" WidthRequest="250" IsVisible="False" x:Name="ImageFrame" VerticalOptions="Center" HorizontalOptions="Center">
                <Image x:Name="FullscreenImage">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="FullscreenImageTapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
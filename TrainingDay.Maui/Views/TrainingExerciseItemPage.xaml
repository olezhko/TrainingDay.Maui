<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TrainingDay.Maui.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:resx="clr-namespace:TrainingDay.Maui.Resources.Strings"
             Shell.TabBarIsVisible="False"
             HideSoftInputOnTapped="True"
             x:Class="TrainingDay.Maui.Views.TrainingExerciseItemPage">
    <Shell.TitleView>
        <Grid Style="{StaticResource PageTitleViewStyle}" ColumnDefinitions="*,auto">
            <Label Style="{StaticResource PageTitleStyle}" Grid.Column="0" Text="{x:Static resx:AppResources.Editing}"/>

            <ImageButton Style="{StaticResource HeaderIconButtonStyle}" Grid.Column="1" Source="save.png" Clicked="Save_clicked"
                         SemanticProperties.Description="{x:Static resx:AppResources.SaveString}"
                         ToolTipProperties.Text="{x:Static resx:AppResources.SaveString}">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=Black, Dark=White}" />
                </ImageButton.Behaviors>
            </ImageButton>
        </Grid>
    </Shell.TitleView>

    <Grid>
        <ScrollView Orientation="Vertical">
            <controls:ExerciseView x:Name="ExerciseView" Margin="5,5,5,15" ImageTappedEvent="ExerciseView_OnImageTappedEvent" />
        </ScrollView>

        <!-- Enlarged image: covers the whole screen (outside the ScrollView), tap anywhere to close -->
        <Grid x:Name="ImageFrame" IsVisible="False" BackgroundColor="#B3000000" Margin="-5">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="FullscreenImageTapped"/>
            </Grid.GestureRecognizers>

            <Border StrokeShape="RoundRectangle 20" Stroke="Transparent" BackgroundColor="White" Padding="10" Margin="20"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Image x:Name="FullscreenImage" Aspect="AspectFit" WidthRequest="320" HeightRequest="320"/>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
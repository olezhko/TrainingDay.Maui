<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrainingDay.Maui.ViewModels"
             xmlns:controls="clr-namespace:TrainingDay.Maui.Controls"
             xmlns:resx="clr-namespace:TrainingDay.Maui.Resources.Strings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:data="clr-namespace:TrainingDay.Common.Models;assembly=TrainingDay.Common" xmlns:models="clr-namespace:TrainingDay.Maui.Models"
             x:Class="TrainingDay.Maui.Controls.ExerciseView"
             x:Name="View">
    <ContentView.Resources>
        <DataTemplate x:Key="RepsItemTemplate" x:DataType="viewModels:WeightAndRepsViewModel">
            <controls:RepsAndWeightControl Margin="0" IsOnlyReps="True" Padding="0"
                    DeleteRequestCommand="{Binding Source={x:Reference View}, Path=DeleteRequestCommand, x:DataType=controls:ExerciseView}"
                    HorizontalOptions="Start" VerticalOptions="Start" Value="{Binding}"
                    WidthRequest="{Binding Source={RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource HalfValueConverter}, ConverterParameter=3, x:DataType=FlexLayout}"/>
        </DataTemplate>

        <DataTemplate x:Key="RepsAndWeightItemTemplate" x:DataType="viewModels:WeightAndRepsViewModel">
            <controls:RepsAndWeightControl Margin="0" Padding="0"
                    DeleteRequestCommand="{Binding Source={x:Reference View}, Path=DeleteRequestCommand, x:DataType=controls:ExerciseView}"
                    HorizontalOptions="Start" VerticalOptions="Start" Value="{Binding}"
                    WidthRequest="{Binding Source={RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource HalfValueConverter}, ConverterParameter=2, x:DataType=FlexLayout}"/>
        </DataTemplate>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="10" x:DataType="viewModels:TrainingExerciseViewModel">
        <!-- Summary card: image, name, target muscles -->
        <Border Style="{StaticResource BorderCellStyle}" Padding="14">
            <VerticalStackLayout Spacing="10">
                <Border StrokeShape="RoundRectangle 15" Stroke="Transparent" Padding="5" BackgroundColor="White" HorizontalOptions="Center">
                    <controls:ImageCache x:Name="ImageControl" HeightRequest="110" WidthRequest="110" CodeNum="{Binding CodeNum}" ExerciseId="{Binding ExerciseId,Mode=TwoWay}"
                                         SemanticProperties.Description="{Binding Name}">
                        <controls:ImageCache.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ImageTapped" />
                        </controls:ImageCache.GestureRecognizers>
                    </controls:ImageCache>
                </Border>

                <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center"
                       SemanticProperties.HeadingLevel="Level2"/>

                <FlexLayout BindableLayout.ItemsSource="{Binding Muscles}" Style="{StaticResource MuscleFlexStyle}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MuscleViewModel">
                            <!--AbsoluteLayout needed for proper draw muscle label. without it cropped in the end-->
                            <AbsoluteLayout>
                                <Border Style="{StaticResource MuscleBorderCellStyle}">
                                    <Label Text="{Binding Name}" FontSize="12" TextColor="White" LineBreakMode="NoWrap"/>
                                </Border>
                            </AbsoluteLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Sets: reps only (3 per row) or reps + weight (2 per row) -->
        <Border Style="{StaticResource BorderCellStyle}" IsVisible="{Binding IsTrackedBySets}">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label FontAttributes="Bold" FontSize="17" VerticalTextAlignment="Center" Margin="4,0,0,0">
                        <Label.Triggers>
                            <DataTrigger Binding="{Binding HasWeight}" TargetType="Label" Value="False">
                                <Setter Property="Text" Value="{x:Static resx:AppResources.RepsString}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasWeight}" TargetType="Label" Value="True">
                                <Setter Property="Text" Value="{x:Static resx:AppResources.RepsAndWeightString}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <ImageButton Grid.Column="1" Style="{StaticResource HeaderIconButtonStyle}" Source="add_empty.png" Clicked="AddWeightAndRepsItem_Clicked"
                                 SemanticProperties.Description="{x:Static resx:AppResources.AddSet}"
                                 ToolTipProperties.Text="{x:Static resx:AppResources.AddSet}">
                        <ImageButton.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=Black, Dark=White}" />
                        </ImageButton.Behaviors>
                    </ImageButton>
                </Grid>

                <FlexLayout AlignContent="Start" AlignItems="Center" BindableLayout.ItemsSource="{Binding WeightAndRepsItems}"
                        Direction="Row" JustifyContent="Start" VerticalOptions="Start" Wrap="Wrap">
                    <FlexLayout.Triggers>
                        <DataTrigger Binding="{Binding HasWeight}" TargetType="FlexLayout" Value="False">
                            <Setter Property="BindableLayout.ItemTemplate" Value="{StaticResource RepsItemTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasWeight}" TargetType="FlexLayout" Value="True">
                            <Setter Property="BindableLayout.ItemTemplate" Value="{StaticResource RepsAndWeightItemTemplate}" />
                        </DataTrigger>
                    </FlexLayout.Triggers>
                </FlexLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Time-based exercise -->
        <Border Style="{StaticResource BorderCellStyle}"
                IsVisible="{Binding Tags, Converter={StaticResource ExerciseTagExistsConverter}, ConverterParameter={x:Static data:ExerciseTags.ExerciseByTime}}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                <Label Text="{x:Static resx:AppResources.TimeString}" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" Margin="4,0,0,0"/>
                <Entry Grid.Column="1" Text="{Binding TimeString}" Placeholder="00:00:00" FontSize="Medium"
                       HorizontalTextAlignment="End" VerticalOptions="Center"
                       SemanticProperties.Description="{x:Static resx:AppResources.TimeString}"/>
            </Grid>
        </Border>

        <!-- Instructions: hidden entirely when the exercise has no description -->
        <Border Style="{StaticResource BorderCellStyle}" Padding="14">
            <Border.IsVisible>
                <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                    <Binding Path="Description.StartPosition" Converter="{StaticResource IsStringNotNullOrEmptyConverter}"/>
                    <Binding Path="Description.Execution" Converter="{StaticResource IsStringNotNullOrEmptyConverter}"/>
                    <Binding Path="Description.Advice" Converter="{StaticResource IsStringNotNullOrEmptyConverter}"/>
                </MultiBinding>
            </Border.IsVisible>

            <VerticalStackLayout Spacing="12">
                <Label Text="{x:Static resx:AppResources.ExerciseInstructions}" FontSize="17" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2"/>

                <VerticalStackLayout Spacing="2" IsVisible="{Binding Description.StartPosition, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
                    <Label FontSize="15" FontAttributes="Bold" Text="{x:Static resx:AppResources.StartPosition}" TextColor="DodgerBlue"/>
                    <Label FontSize="14" Text="{Binding Description.StartPosition}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2" IsVisible="{Binding Description.Execution, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
                    <Label FontSize="15" FontAttributes="Bold" Text="{x:Static resx:AppResources.Execution}" TextColor="LimeGreen"/>
                    <Label FontSize="14" Text="{Binding Description.Execution}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2" IsVisible="{Binding Description.Advice, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
                    <Label FontSize="15" FontAttributes="Bold" Text="{x:Static resx:AppResources.Advice}" TextColor="Orange"/>
                    <Label FontSize="14" Text="{Binding Description.Advice}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
